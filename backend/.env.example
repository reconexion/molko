DATABASE_URL=sqlite:///./molko.db

# "production" apaga /docs y /openapi.json.
ENVIRONMENT=development

# Firma de las sesiones (obligatoria: el servidor no arranca con el valor por defecto ni con menos de 32 caracteres). Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# Lanzamiento controlado: máximo de cuentas (0 = sin límite). Al llenarse, el
# registro se cierra y la gente entra a la lista de espera.
MAX_USERS=0

# Descargador de YouTube: interruptor de apagado y límites por usuario.
YOUTUBE_ENABLED=true
YOUTUBE_MONTHLY_LIMIT=20
YOUTUBE_MAX_DURATION_SECONDS=1800

# Stripe (https://dashboard.stripe.com/test/apikeys). Guía completa en el README, "Configurar Stripe".
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_ANNUAL=price_...

# Deepgram (https://console.deepgram.com). Solo se usará cuando vuelvan los subtítulos
# automáticos (función futura, hoy desactivada): no hace falta para correr Molko.
DEEPGRAM_API_KEY=

# Iniciar sesión con Google (opcional; sin estos dos valores el botón no aparece). Crea un
# "ID de cliente de OAuth" de tipo "Aplicación web" en https://console.cloud.google.com/apis/credentials
# y registra como URI de redireccionamiento: <BACKEND_URL>/auth/google/callback
# El secreto va SOLO aquí, nunca en el frontend ni en el repositorio.
BACKEND_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
